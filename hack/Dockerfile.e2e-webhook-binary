# Webhook image for local E2E: binary plus admission-init script (openssl + kubectl).
FROM alpine:latest
ARG KUBE_VERSION="1.36.0"
ARG TARGETARCH
RUN apk add --no-cache ca-certificates openssl curl && \
    curl -fsSL "https://dl.k8s.io/release/v${KUBE_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
      -o /usr/local/bin/kubectl && \
    chmod +x /usr/local/bin/kubectl && \
    rm -rf /var/cache/apk/*
COPY _output/bin/vc-webhook-manager /vc-webhook-manager
COPY installer/dockerfile/webhook-manager/gen-admission-secret.sh /gen-admission-secret.sh
RUN chmod +x /vc-webhook-manager /gen-admission-secret.sh
WORKDIR /
ENTRYPOINT ["/vc-webhook-manager"]
